# Epoch Skin — required environment variables
# Set these in Vercel: Project → Settings → Environment Variables (Production + Preview)

# Stripe — LIVE mode keys for production. No NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
# is needed: this site uses Stripe Checkout redirect (session.url), not
# Stripe.js/Elements, so nothing Stripe-related runs client-side.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...   # from Stripe Dashboard → Developers → Webhooks → your endpoint

# Turso (booking/order/newsletter/contact database)
# Tables are created automatically (CREATE TABLE IF NOT EXISTS + migrations)
# the first time any route touches the DB — no manual schema setup needed.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Resend (all transactional + notification email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@epoch-skin.com   # must be on a domain verified in Resend
RESEND_TO_EMAIL=kayla@epoch-skin.com     # owner notifications land here
NEWSLETTER_TO=kayla@epoch-skin.com       # "new subscriber" notifications land here

# Admin panel (/admin, /admin/bookings, /admin/orders, /admin/newsletter, /admin/contact)
ADMIN_PASSWORD=choose_a_strong_password

# Stripe → product sync (/admin/sync)
SYNC_SECRET=choose_a_strong_secret

# Site
NEXT_PUBLIC_SITE_URL=https://epoch-skin.com

# Newsletter engine (cron-triggered draft generator + approve/reject/send +
# /news archive — see lib/newsletter-engine/). Vercel auto-injects the
# Authorization: Bearer header for cron routes when CRON_SECRET is set.
ANTHROPIC_API_KEY=sk-ant-...
CRON_SECRET=choose_a_strong_secret
NEWSLETTER_SECRET=choose_a_strong_secret   # signs approve/reject/unsubscribe links
APPROVER_EMAIL=flu.wop@gmail.com           # draft review emails land here
