# Appointment Booking Integration
# Choose one: Calendly, Cal.com, or Acuity Scheduling
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-username
# OR
# NEXT_PUBLIC_CALCOM_API_KEY=your_cal_com_api_key

# Stripe Payment Processing
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Email Marketing
# Choose one: Mailchimp, ConvertKit, or SendGrid
MAILCHIMP_API_KEY=your_mailchimp_api_key
MAILCHIMP_LIST_ID=your_list_id
# OR
# CONVERTKIT_API_KEY=your_convertkit_api_key
# CONVERTKIT_FORM_ID=your_form_id

# Contact Form
# Option 1: Formspree (easiest)
FORMSPREE_FORM_ID=your_formspree_form_id
# Option 2: SendGrid for custom email
# SENDGRID_API_KEY=your_sendgrid_api_key
# CONTACT_EMAIL=hello@epochskin.com

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
