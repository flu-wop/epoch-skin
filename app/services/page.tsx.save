# (replace entire content with above, save with Ctrl+X, Y, Enter)"use client";

import { useState } from "react";
import { Container } from "@/components/layout/Container";
import { ServiceCard } from "@/components/services/ServiceCard";
import { ServiceFilter } from "@/components/services/ServiceFilter";
import { services, getServicesByGender, type ServiceGender } from "@/data/services";
import { Button } from "@/components/ui/button";
import Link from "next/link";

export default function ServicesPage() {
  const [genderFilter, setGenderFilter] = useState<ServiceGender>("all");
  
  // Filter services by gender, then group by category
  const filteredServices = getServicesByGender(genderFilter);
  const bodyWaxing = filteredServices.filter((s) => s.category === "body-waxing");
  const facialWaxing = filteredServices.filter((s) => s.category === "facial-waxing");
  const specialtyTreatments = filteredServices.filter((s) => s.category === "specialty-treatments");

  return (
    <>
      {/* Hero section – exact same structure & classes */}
      <section className="bg-gradient-to-br from-sage-50 via-sand-50 to-sage-50 py-16 lg:py-24">
        <Container>
          <div className="mx-auto max-w-3xl text-center">
            <h1 className="font-serif text-5xl font-bold text-sage-900 sm:text-6xl">
              Our Services
            </h1>
            <p className="mt-6 text-lg text-neutral-600 leading-relaxed">
              Experience expert waxing and curated organic skincare in a calm, luxurious setting.
              We use only premium, gentle products for smooth, radiant results every time.
            </p>
            <Button
              asChild
              size="lg"
              className="mt-8 bg-clay-500 hover:bg-clay-600"
            >
              <Link href="/book">Book Your Appointment</Link>
            </Button>
          </div>
        </Container>
      </section>

      {/* Gender Filter – NEW but matching design */}
      <section className="py-8 lg:py-12 border-b border-gray-100">
        <Container>
          <ServiceFilter 
            currentFilter={genderFilter} 
            onFilterChange={setGenderFilter} 
          />
        </Container>
      </section>

      {/* Body Waxing section – same grid & styling */}
      {bodyWaxing.length > 0 && (
        <section className="py-16 lg:py-24">
          <Container>
            <div className="mb-12">
              <h2 className="font-serif text-4xl font-bold text-sage-900">
                Body Waxing
              </h2>
              <p className="mt-3 text-lg text-neutral-600">
                Full-body and targeted waxing services for smooth, long-lasting results.
              </p>
            </div>
            <div className="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
              {bodyWaxing.map((service) => (
                <ServiceCard key={service.id} service={service} />
              ))}
            </div>
          </Container>
        </section>
      )}

      {/* Facial Waxing section – same background & layout */}
      {facialWaxing.length > 0 && (
        <section className="bg-sage-50/30 py-16 lg:py-24">
          <Container>
            <div className="mb-12">
              <h2 className="font-serif text-4xl font-bold text-sage-900">
                Facial Waxing
              </h2>
              <p className="mt-3 text-lg text-neutral-600">
                Gentle, precise facial waxing to enhance your natural glow and clarity.
              </p>
            </div>
            <div className="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
              {facialWaxing.map((service) => (
                <ServiceCard key={service.id} service={service} />
              ))}
            </div>
          </Container>
        </section>
      )}

      {/* Specialty Treatments section – matching style */}
      {specialtyTreatments.length > 0 && (
        <section className="py-16 lg:py-24">
          <Container>
            <div className="mb-12">
              <h2 className="font-serif text-4xl font-bold text-sage-900">
                Specialty Treatments
              </h2>
              <p className="mt-3 text-lg text-neutral-600">
                Organic facials and K-Beauty inspired treatments for radiant, healthy skin.
              </p>
            </div>
            <div className="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
              {specialtyTreatments.map((service) => (
                <ServiceCard key={service.id} service={service} />
              ))}
            </div>
          </Container>
        </section>
      )}

      {/* Pre/Post care tips – same layout, updated content for waxing */}
      <section className="py-16 lg:py-24 bg-sage-50/30">
        <Container>
          <div className="mx-auto max-w-4xl">
            <h2 className="text-center font-serif text-4xl font-bold text-sage-900">
              Waxing Aftercare Tips
            </h2>

            <div className="mt-12 grid gap-8 md:grid-cols-2">
              {/* Pre-care */}
              <div className="rounded-xl border border-sage-100 bg-white p-8">
                <h3 className="font-serif text-2xl font-semibold text-sage-900">
                  Before Your Appointment
                </h3>
                <ul className="mt-6 space-y-4">
                  <li className="flex items-start gap-3">
                    <div className="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-clay-500"></div>
                    <span className="text-neutral-700">
                      Let hair grow to at least ¼ inch for best results
                    </span>
                  </li>
                  <li className="flex items-start gap-3">
                    <div className="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-clay-500"></div>
                    <span className="text-neutral-700">
                      Gently exfoliate 24–48 hours before (no harsh scrubs)
                    </span>
                  </li>
                  <li className="flex items-start gap-3">
                    <div className="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-clay-500"></div>
                    <span className="text-neutral-700">
                      Avoid caffeine, alcohol, and blood-thinning meds 24 hours prior
                    </span>
                  </li>
                  <li className="flex items-start gap-3">
                    <div className="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-clay-500"></div>
                    <span className="text-neutral-700">
                      Arrive with clean, dry skin — no lotions, oils, or deodorant
                    </span>
                  </li>
                </ul>
              </div>

              {/* Post-care */}
              <div className="rounded-xl border border-sage-100 bg-white p-8">
                <h3 className="font-serif text-2xl font-semibold text-sage-900">
                  After Your Appointment
                </h3>
                <ul className="mt-6 space-y-4">
                  <li className="flex items-start gap-3">
                    <div className="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-clay-500"></div>
                    <span className="text-neutral-700">
                      Avoid hot showers, saunas, steam rooms, and sun exposure for 24–48 hours
                    </span>
                  </li>
                  <li className="flex items-start gap-3">
                    <div className="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-clay-500"></div>
                    <span className="text-neutral-700">
                      Skip tight clothing and exercise/sweating for 24 hours
                    </span>
                  </li>
                  <li className="flex items-start gap-3">
                    <div className="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-clay-500"></div>
                    <span className="text-neutral-700">
                      Wear loose, breathable clothing to prevent irritation
                    </span>
                  </li>
                  <li className="flex items-start gap-3">
                    <div className="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-clay-500"></div>
                    <span className="text-neutral-700">
                      Moisturize daily with a gentle, fragrance-free lotion
                    </span>
                  </li>
                  <li className="flex items-start gap-3">
                    <div className="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-clay-500"></div>
                    <span className="text-neutral-700">
                      Exfoliate gently 2–3 times per week to prevent ingrown hairs
                    </span>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </Container>
      </section>

      {/* CTA section – same gradient, same button style */}
      <section className="bg-gradient-to-br from-clay-50 to-sand-50 py-16">
        <Container>
          <div className="text-center">
            <h2 className="font-serif text-3xl font-bold text-sage-900 sm:text-4xl">
              Ready to Book?
            </h2>
            <p className="mt-4 text-lg text-neutral-600">
              Schedule your appointment today and experience the Epoch Skin difference.
            </p>
            <Button
              asChild
              size="lg"
              className="mt-8 bg-clay-500 hover:bg-clay-600"
            >
              <Link href="/book">Book Your Service</Link>
            </Button>
          </div>
        </Container>
      </section>
    </>
